# GEMINI_API_KEY: Required for Gemini AI API calls on Vercel Serverless Functions and local Express backend.
# In Vercel: Add this in Project Settings -> Environment Variables.
# AI Studio automatically injects this at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Auth & PostgreSQL (Optional - can also be configured via in-app UI)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
